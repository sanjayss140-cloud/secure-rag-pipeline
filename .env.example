# SecureRAG Configuration Environment Variables

# Database (PostgreSQL recommended; defaults to local SQLite if unset)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/securerag

# Redis (For sliding window rate limiting and caching; in-memory fallback if unset)
REDIS_URL=redis://localhost:6379/0

# Security Secrets
JWT_SECRET=replace_with_a_secure_random_32_byte_secret_key!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Groq API Key or leave empty for Ollama fallback)
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# Server & Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
